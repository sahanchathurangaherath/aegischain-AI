
# AegisChain — Environment Configuration (.env.example)


# --- PostgreSQL (Docker Compose & Django) ---
POSTGRES_DB=aegischain_db
POSTGRES_USER=aegis_user
POSTGRES_PASSWORD=change_me_local_postgres_password

DB_NAME=aegischain_db
DB_USER=aegis_user
DB_PASSWORD=change_me_local_postgres_password
DB_HOST=postgres
DB_PORT=5432

# --- ERP Backend (erp_core) ---
DEBUG=True
SECRET_KEY=change_me_local_django_secret_key
ALLOWED_HOSTS=localhost,127.0.0.1,erp
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8001

# --- AI Layer (aegis_ai) ---
APP_NAME=AegisChain AI
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8001
ERP_API_URL=http://erp:8000/api
ERP_API_TOKEN=change_me_local_erp_api_token
MAX_AGENTS=10
AGENT_TIMEOUT=30
ENABLE_LOGGING=True
